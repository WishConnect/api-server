	('충남', NULL, NOW(), NOW()),
	('전북', NULL, NOW(), NOW()),
	('전남', NULL, NOW(), NOW()),
	('경북', NULL, NOW(), NOW()),
	('경남', NULL, NOW(), NOW()),
	('제주', NULL, NOW(), NOW())
ON CONFLICT DO NOTHING;

-- 테스트 사용자 1명 (UUID 고정)
