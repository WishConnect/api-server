# application-prod.yml 템플릿 (운영)
# 실제 application-prod.yml 은 .gitignore 대상이며, 민감정보는 배포 환경의 '환경변수'로 주입한다.
#   - DB 비밀번호, 카카오 키, JWT secret 등은 절대 Git/코드에 포함하지 않는다.
spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://<PROD_DB_HOST>:5432/wishconnect}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: org.postgresql.Driver
  data:
    redis:
      host: ${REDIS_HOST}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
  jpa:
    hibernate:
      # 운영: 스키마 자동 변경 금지. 마이그레이션 도구로 관리
      ddl-auto: validate
    show-sql: false

jwt:
  secret: ${JWT_SECRET}

kakao:
  client-id: ${KAKAO_CLIENT_ID}
  client-secret: ${KAKAO_CLIENT_SECRET}
  redirect-uri: ${KAKAO_REDIRECT_URI:https://api.wishconnect.kr/v1/auth/kakao/callback}
