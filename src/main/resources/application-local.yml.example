# application-local.yml 템플릿
# 이 파일을 복사해 application-local.yml 로 만들고 로컬 환경에 맞게 값을 채우세요.
#   cp application-local.yml.example application-local.yml
# (application-local.yml 은 민감정보 파일이라 .gitignore 처리되어 있습니다.)
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/wishconnect
    username: <DB_USERNAME>
    password: <DB_PASSWORD>
    driver-class-name: org.postgresql.Driver
  data:
    redis:
      # Refresh Token 저장용
      host: localhost
      port: 6379
      # password: <REDIS_PASSWORD>   # 비밀번호 없으면 주석 유지
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

jwt:
  # HS256 비밀키 (최소 32바이트). 운영에서는 반드시 환경변수 JWT_SECRET 로 주입
  secret: ${JWT_SECRET:<DEV_JWT_SECRET_MIN_32_BYTES>}

kakao:
  client-id: ${KAKAO_CLIENT_ID:<KAKAO_REST_API_KEY>}
  client-secret: ${KAKAO_CLIENT_SECRET:}
  redirect-uri: ${KAKAO_REDIRECT_URI:http://localhost:8080/api/v1/auth/kakao/callback}
