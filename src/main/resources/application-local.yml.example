# application-local.yml 템플릿
# 이 파일을 복사해 application-local.yml 로 만들고 로컬 환경에 맞게 값을 채우세요.
#   cp application-local.yml.example application-local.yml
# (application-local.yml 은 민감정보 파일이라 .gitignore 처리되어 있습니다.)
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/wishconnect
    username: <DB_USERNAME>
    password: <DB_PASSWORD>
    driver-class-name: org.postgresql.Driver
  # AI 자기소개서 파트 로컬 테스트 시, JPA가 엔티티로부터 테이블을 자동 생성하도록 설정하고
  # data-local.sql 을 통해 FK 대상(users/scholarship/essay_question) 시드 데이터를 주입한다.
  # (data-local.sql 은 .gitignore 대상. data-local.sql.example 참고)
  # jpa:
  #   hibernate:
  #     ddl-auto: create-drop
  # sql:
  #   init:
  #     mode: always
  #     data-locations: classpath:data-local.sql
  data:
    redis:
      # Refresh Token 저장용
      host: localhost
      port: 6379
      # password: <REDIS_PASSWORD>   # 비밀번호 없으면 주석 유지
  mail:
    # AWS SES SMTP 자격증명 (없으면 비워두면 발송만 실패)
    username: ${MAIL_USERNAME:<SES_SMTP_USERNAME>}
    password: ${MAIL_PASSWORD:<SES_SMTP_PASSWORD>}
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

jwt:
  # HS256 비밀키 (최소 32바이트). 운영에서는 반드시 환경변수 JWT_SECRET 로 주입
  secret: ${JWT_SECRET:<DEV_JWT_SECRET_MIN_32_BYTES>}

kakao:
  client-id: ${KAKAO_CLIENT_ID:<KAKAO_REST_API_KEY>}
  client-secret: ${KAKAO_CLIENT_SECRET:}
  redirect-uri: ${KAKAO_REDIRECT_URI:http://localhost:8080/api/v1/auth/kakao/callback}

# 구글/네이버 OAuth (소셜 로그인)
google:
  client-id: ${GOOGLE_CLIENT_ID:<GOOGLE_CLIENT_ID>}
  client-secret: ${GOOGLE_CLIENT_SECRET:<GOOGLE_CLIENT_SECRET>}
  redirect-uri: ${GOOGLE_REDIRECT_URI:http://localhost:8080/api/v1/auth/google/callback}

naver:
  client-id: your-naver-oauth-client-id
  client-secret: your-naver-oauth-client-secret
  redirect-uri: http://localhost:3000/auth/naver/callback
  search:
    client-id: your-naver-search-client-id
    client-secret: your-naver-search-client-secret

# 대학알리미/공공데이터 학교·학과 마스터 동기화
academic-info:
  api:
    service-key: ${ACADEMIC_INFO_API_SERVICE_KEY:<PUBLIC_DATA_SERVICE_KEY>}
    school-base-url: ${ACADEMIC_INFO_SCHOOL_BASE_URL:https://apis.data.go.kr/B340014/BasicInformationService_2}
    school-path: ${ACADEMIC_INFO_SCHOOL_PATH:/getUniversityCode}
    major-base-url: ${ACADEMIC_INFO_MAJOR_BASE_URL:https://apis.data.go.kr/B340014/BasicInformationService_1}
    major-path: ${ACADEMIC_INFO_MAJOR_PATH:/getUniversityMajorCode}
    page-size: ${ACADEMIC_INFO_PAGE_SIZE:1000}
    max-pages: ${ACADEMIC_INFO_MAX_PAGES:100}
    # 대학 학과 정보 API의 필수 파라미터(svyYr). 포털 상세설명에서 조회 가능한 조사년도를 확인해 입력합니다.
    survey-year: ${ACADEMIC_INFO_SURVEY_YEAR:2025}

# Anthropic Claude API 키. AI 자기소개서 파트(사전 인터뷰·초안 생성) 로컬 테스트 시 필요.
# 환경변수 ANTHROPIC_API_KEY 로 주입하는 것을 권장.
# 모델 ID / max-tokens 는 application.yml 의 llm.anthropic 기본값을 그대로 사용한다.
#   export ANTHROPIC_API_KEY=sk-ant-...

# S3 이미지 저장. 로컬에서 포스터 이미지 수집까지 테스트할 때만 실제 값을 넣습니다.
# 값이 비어 있으면 장학금 수집은 계속되지만 이미지 업로드만 실패합니다.
app:
  s3:
    bucket: ${AWS_S3_BUCKET:wishconnect-images}
    region: ${AWS_S3_REGION:ap-northeast-2}
    access-key: ${AWS_ACCESS_KEY_ID:}
    secret-key: ${AWS_SECRET_ACCESS_KEY:}
