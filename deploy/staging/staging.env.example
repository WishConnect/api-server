# GitHub staging 환경의 STAGING_ENV_FILE secret에 설정한다. 운영 접속정보를 복사하지 않는다.
# 기존 테이블이 준비된 별도 DB가 필요하다. 새 비교 이력 SQL만 배포 시 자동 적용한다.
STAGING_DB_URL=jdbc:postgresql://127.0.0.1:15439/wishconnect_staging
STAGING_DB_USERNAME=staging_user
STAGING_DB_PASSWORD=replace-me
STAGING_REDIS_HOST=127.0.0.1
STAGING_REDIS_PORT=16389
STAGING_REDIS_DATABASE=1
STAGING_JWT_SECRET=replace-with-an-independent-long-random-secret
# 실제 비교 요청을 보낼 때만 과금된다. 설정하지 않으면 외부 LLM 호출은 인증 오류로 기록된다.
ANTHROPIC_PARSER_API_KEY=
