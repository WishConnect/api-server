# EC2 EnvironmentFile 템플릿 (실제 파일: /etc/wishconnect/wishconnect.env, 권한 600, git 미포함)
# 이 값들은 GitHub Actions 배포 시 GitHub Secrets 로부터 자동 기록됩니다.
# (수동 세팅 시엔 이 파일을 복사해 실제 값을 채우고 chmod 600)
SPRING_PROFILES_ACTIVE=prod

# --- API 문서(Swagger) --- 운영은 끈다. 배포 워크플로가 false 로 기록한다(prod 기본값도 false)
SWAGGER_ENABLED=false

# --- DB (RDS PostgreSQL) ---
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/wishconnect
DB_USERNAME=<RDS_USERNAME>
DB_PASSWORD=<RDS_PASSWORD>

# --- Redis (EC2 로컬) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=<HS256_SECRET_MIN_32_BYTES>

# --- AWS SES SMTP ---
MAIL_USERNAME=<SES_SMTP_USERNAME>
MAIL_PASSWORD=<SES_SMTP_PASSWORD>
MAIL_FROM=no-reply@wish-connect.com

# --- 프론트 CORS 허용 출처 (프론트 도메인) ---
FRONTEND_ORIGIN=https://wish-connect.com

# --- sitemap.xml (검색엔진 색인 대상은 프론트 도메인의 페이지다) ---
# 프론트 라우팅이 바뀌면 SITEMAP_SCHOLARSHIP_PATH / SITEMAP_STATIC_PATHS 만 고치면 된다.
SITEMAP_BASE_URL=https://wish-connect.com
# SITEMAP_SCHOLARSHIP_PATH=/scholarships/{id}
# SITEMAP_STATIC_PATHS=/,/scholarships,/insights
# SITEMAP_INCLUDE_CLOSED=true
# robots.txt 에서 수집을 막을 경로(프론트 경로 기준 + API·문서 경로)
# ROBOTS_DISALLOW_PATHS=/api/,/admin,/swagger-ui,/v3/api-docs,/auth/

# --- 소셜 OAuth (redirect-uri 는 운영 프론트 콜백 = 프론트 도메인) ---
KAKAO_CLIENT_ID=<KAKAO_REST_API_KEY>
KAKAO_CLIENT_SECRET=<KAKAO_CLIENT_SECRET>
KAKAO_REDIRECT_URI=https://wish-connect.com/auth/kakao/callback

GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://wish-connect.com/auth/google/callback

NAVER_CLIENT_ID=<NAVER_CLIENT_ID>
NAVER_CLIENT_SECRET=<NAVER_CLIENT_SECRET>
NAVER_REDIRECT_URI=https://wish-connect.com/auth/naver/callback
