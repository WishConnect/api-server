# WishConnect 앱 로그 로테이션
# EC2 설치 위치: /etc/logrotate.d/wishconnect
# 설치 후 확인: sudo logrotate -d /etc/logrotate.d/wishconnect   (-d 는 시뮬레이션)
#
# 배경: systemd 유닛이 StandardOutput=append: 로 app.log 를 열어둔 채 쓴다.
#   - copytruncate 필수. 기본 방식(rename + create)으로 돌리면 열려 있는 fd 가
#     옛 inode 를 계속 가리켜, 로테이션된 파일에 로그가 계속 쌓이고 새 app.log 는 비어 있게 된다.
#   - su root root 필수. 로그 디렉터리가 ubuntu:ubuntu(그룹 쓰기 가능)라
#     logrotate 가 "insecure permissions" 로 건너뛴다. 로테이션 주체를 명시해야 동작한다.
/home/ubuntu/app/logs/app.log {
    su root root
    daily
    rotate 7
    copytruncate
    compress
    delaycompress
    missingok
    notifempty
}
